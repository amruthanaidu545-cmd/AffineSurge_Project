# LLM provider: any OpenAI-compatible chat-completions endpoint, or "mock" for offline demo/tests
LLM_PROVIDER=mock                 # mock | openai_compat
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_JSON_MODE=1                   # send response_format=json_object (disable if provider rejects it)
LLM_MAX_RETRIES=2                 # validation-repair retries after the first attempt
DATABASE_URL=sqlite:///./ct200.db
GENERATION_STORE_DIR=./data/generations
DATA_DIR=./data
